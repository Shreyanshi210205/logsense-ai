GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
API_PORT=3100

# Compose services use the internal Kafka address.
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=sentient-log-api
KAFKA_RAW_EVENTS_TOPIC=raw-events
KAFKA_CONSUMER_GROUP=clickhouse-writers-group

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=sentient_log
# Admin / ingestion identity. This user runs migrations and writes events.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Dedicated least-privilege identity used only by POST /api/v1/query.
CLICKHOUSE_AI_USER=sentient_ai
# Use a strong, unique secret. Required before running npm run migrate.
CLICKHOUSE_AI_PASSWORD=

# Hosted Neon PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
