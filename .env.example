GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local API processes use localhost:9094. A containerized API should use kafka:9092.
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=sentient-log-api
KAFKA_RAW_EVENTS_TOPIC=raw-events

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=sentient_log
# Admin / ingestion identity. This user runs migrations and writes events.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Dedicated least-privilege identity used only by POST /api/v1/query.
CLICKHOUSE_AI_USER=sentient_ai
# Use a strong, unique secret. Required before running npm run migrate.
CLICKHOUSE_AI_PASSWORD=
